{
  "name": "simple_ioc",
  "description": "Single IP address flagged as suspicious — should map to a known C2 domain.",
  "seed": {
    "type": "ioc",
    "raw_payload": {
      "entities": [
        {"type": "ip", "value": "192.0.2.100"}
      ],
      "source": "threat_intel_feed"
    },
    "metadata": {"severity": "high", "confidence": 0.9}
  },
  "expected_hypotheses": [
    {
      "description": "IP 192.0.2.100 is associated with known C2 infrastructure",
      "confidence": 4
    }
  ],
  "expected_confidence": 4,
  "telemetry": [
    {
      "source": "firewall",
      "events": [
        {"src_ip": "192.0.2.100", "dst_ip": "10.0.0.5", "action": "ALLOW", "port": 443}
      ]
    }
  ],
  "expected_evidence": [
    {
      "source_type": "threat_intel",
      "source_id": "c2-domain-match"
    },
    {
      "source_type": "firewall",
      "source_id": "egress-443"
    }
  ]
}
