# WolfPack Docker Compose local overrides.
# Copy to docker-compose.override.yml and adjust for your environment.
# This file is gitignored — it never leaves your machine.

services:
  ollama:
    # Uncomment to expose the Ollama API on the host.
    # ports:
    #   - "11434:11434"

    # Override the smoke model (default: llama3.2:1b).
