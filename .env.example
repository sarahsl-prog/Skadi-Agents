# WolfPack environment configuration template.
# Copy this file to .env and fill in values for your deployment.
# Never commit .env — it is gitignored.
#
# Nested fields use __ as the delimiter (e.g., LLM__PROVIDER maps to llm.provider).

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# One of: dev | on_prem_connected | on_prem_airgapped
#   dev               — local development; all providers allowed
#   on_prem_connected — on-premises, outbound access permitted for e.g. threat intel
#   on_prem_airgapped — fully isolated; hosted providers and public URLs are rejected at startup
DEPLOYMENT_MODE=dev

# ---------------------------------------------------------------------------
# LLM configuration
# ---------------------------------------------------------------------------
# Provider: ollama | openai_compatible
LLM__PROVIDER=ollama

# Base URL for the LLM server.
# In on_prem_airgapped mode this must be a loopback (127.x, localhost) or
# RFC-1918 private address (10.x, 172.16-31.x, 192.168.x).
LLM__BASE_URL=http://localhost:11434

# Model name as understood by the provider (e.g. llama3.2:1b for CI/dev, llama3.3:70b for prod)
LLM__MODEL=llama3.2:1b

# API key (required for hosted or authenticated endpoints; omit for local Ollama)
# LLM__API_KEY=

# Set to true if using a hosted service such as Ollama Cloud (forbidden in airgapped mode)
LLM__HOSTED=false

# Per-request timeout in seconds
LLM__REQUEST_TIMEOUT_S=60.0

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Full DSN including credentials. pgvector extension is required.
POSTGRES__DSN=postgresql://wolfpack:changeme@localhost:5432/wolfpack

# Connection pool bounds
POSTGRES__POOL_MIN_SIZE=2
POSTGRES__POOL_MAX_SIZE=10

# ---------------------------------------------------------------------------
# NATS JetStream
# ---------------------------------------------------------------------------
NATS__URL=nats://localhost:4222

# ---------------------------------------------------------------------------
# OpenTelemetry Collector
# ---------------------------------------------------------------------------
# OTLP HTTP endpoint. The OTel Collector listens on :4318 by default.
OTEL__ENDPOINT=http://localhost:4318
OTEL__SERVICE_NAME=wolfpack
OTEL__SERVICE_NAMESPACE=wolfpack

# ---------------------------------------------------------------------------
# MLflow tracking server
# ---------------------------------------------------------------------------
MLFLOW__TRACKING_URI=http://localhost:5000

# ---------------------------------------------------------------------------
# Alert webhook
# ---------------------------------------------------------------------------
# Optional webhook URL for alert and timeout-escalation notifications.
WEBHOOK_CONFIG__URL=http://localhost:8000/api/webhooks/alerts

# ---------------------------------------------------------------------------
# Optional OTel Collector exporter endpoints (override defaults)
# ---------------------------------------------------------------------------
# Enable MLflow OTLP ingestion by setting these and uncommenting the exporter:
# WOLFPACK_MLFLOW_OTEL_ENDPOINT=http://mlflow:5000/api/2.0/mlflow/traces
# Enable Jaeger OTLP ingestion (requires the 'tracing' compose profile):
# WOLFPACK_JAEGER_OTEL_ENDPOINT=http://jaeger:4317

